{
  "name": "feedbackflow-notifier",
  "version": "0.1.0",
  "private": true,
  "description": "Fans FeedbackFlow events out to webhooks (Slack-compatible or signed JSON).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
