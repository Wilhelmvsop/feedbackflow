# Copy to .env (never commit it). Every value is optional for local development.

# development | test | production. Production refuses the default demo password.
APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default; PostgreSQL works too (postgres:// URLs are normalised automatically).
DATABASE_URL=sqlite:///./feedbackflow.db
# DATABASE_URL=postgresql+psycopg://feedbackflow:local-feedbackflow@localhost:5432/feedbackflow
AUTO_MIGRATE=true

# Comma-separated origins allowed to call the API (dashboard dev server, sites embedding the widget).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TOKEN_TTL_HOURS=168
LOGIN_RATE_LIMIT=10
PUBLIC_FEEDBACK_RATE_LIMIT=20

# Demo workspace (created once on first start).
SEED_DEMO=true
DEMO_EMAIL=demo@feedbackflow.local
DEMO_PASSWORD=feedbackflow-demo
DEMO_WORKSPACE_SLUG=demo

# Optional OpenAI-compatible model. Leave empty to use the offline deterministic analyzer.
# Setting a key sends feedback text to that provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# MCP server (python -m app.mcp_server)
MCP_WORKSPACE_SLUG=demo
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Required whenever MCP_HOST is not loopback.
MCP_ACCESS_TOKEN=

# Notifier service (services/notifier). Leave empty to disable event publishing.
NOTIFIER_URL=
NOTIFIER_TOKEN=
